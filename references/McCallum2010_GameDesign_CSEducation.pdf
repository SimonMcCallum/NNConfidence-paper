window.loswp.work = {"work":{"id":63162458,"created_at":"2021-12-03T20:55:02.070-08:00","from_world_paper_id":185725268,"updated_at":"2025-10-11T21:59:03.159-07:00","_data":{"publisher":"tapironline.no","key_takeaways":"[\"Integrating game design principles enhances engagement in computer science education.\", \"Students expect instant feedback, creating a gap with traditional assessment methods.\", \"Game mechanics like XP can improve motivation and track student progress effectively.\", \"Balancing challenge and skill is crucial for both game design and instructional strategies.\", \"The study found a positive correlation (r=0.79) between multiple-choice and short answer exam performance.\"]","grobid_abstract":"Computer science students come from the gamer generation. A generation accustomed to receiving instant feedback and constant reward for action. This expectation creates tension between traditional assessment models and the learning style of the gamers taking our courses.","publication_date":"2010,,","publication_name":"Norsk informatikkonferanse (NIK)","markdown_attachment_ids":"75676862","grobid_abstract_attachment_id":"75676862"},"document_type":"paper","pre_hit_view_count_baseline":null,"quality":"high","language":"en","title":"Game Design for Computer Science Education","broadcastable":true,"draft":null,"has_indexable_attachment":true,"indexable":true,"seo_quality":8,"owner_type":"USER_OWNED"}}["work"];
