@inproceedings{fadeeva2024lmpolygraph,
  title     = {{LM}-Polygraph: Uncertainty Estimation for Language Models},
  author    = {Fadeeva, Ekaterina and Vashurin, Roman and Tsimpoukelli, Anej and Vazhentsev, Artem and Petrakov, Sergey and Fedyanin, Kirill and Shelmanov, Artem and Panchenko, Alexander and Baldwin, Timothy and Panov, Maxim and Shmatova, Elena},
  booktitle = {Proceedings of the 2023 Conference on Empirical Methods in Natural Language Processing: System Demonstrations (EMNLP)},
  year      = {2023},
